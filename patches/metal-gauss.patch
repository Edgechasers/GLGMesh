--- a/metal_gauss/csrc/rasterize.metal
+++ b/metal_gauss/csrc/rasterize.metal
@@ -374,3 +374,27 @@ kernel void pack_intersections(
     p_conic[i]   = conic[g];
     p_rgb[i]     = color[g];
 }
+
+// Task adaptation: GauStudio median depth, crossing absolute transmittance 0.5.
+kernel void median_forward(
+ device const float2* uv [[buffer(0)]], device const packed_float3* conic [[buffer(1)]],
+ device const float* opacity [[buffer(2)]], device const float* depth [[buffer(3)]],
+ device const int* ids [[buffer(4)]], device const int* offsets [[buffer(5)]],
+ device float* result [[buffer(6)]], constant uint4& dims [[buffer(7)]],
+ uint2 gid [[thread_position_in_grid]]) {
+ if(gid.x>=dims.x || gid.y>=dims.y) return;
+ uint tid=(gid.y/dims.z)*dims.w+gid.x/dims.z;
+ float2 px=float2(gid)+0.5f; float T=1.0f; float z=0.0f;
+ for(int j=offsets[tid]; j<offsets[tid+1]; ++j){
+  int i=ids[j]; float2 d=px-uv[i]; float3 c=conic[i];
+  float power=-0.5f*(c.x*d.x*d.x+2*c.y*d.x*d.y+c.z*d.y*d.y);
+  if(power>0.0f) continue;
+  float a=min(0.99f,opacity[i]*exp(power));
+  if(a<1.0f/255.0f) continue;
+  float nt=T*(1-a);
+  if(nt<0.0001f) break;
+  if(T>0.5f && nt<0.5f){ z=depth[i]; break; }
+  T=nt;
+ }
+ result[gid.y*dims.x+gid.x]=z;
+}
